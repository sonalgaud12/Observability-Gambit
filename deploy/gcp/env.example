# Settings for `make up-prod` (copy to .env.prod, which is git-ignored; never commit real values).
# On the VM the same variables come from /etc/gambit/gambit.env (non-secret, written by
# startup-script.sh from instance metadata) and /run/gambit/env (secrets, written from
# Secret Manager by fetch-secrets.sh). Mirrors .env.cloud.example.

# Public hostname of the game. dash.<it> is served too (dashboards and the trace links). A name ending
# in .localhost gets a local Caddy certificate (testing on a laptop).
GAMBIT_DOMAIN=gambit.example.org

# Shared Grafana Cloud stack (see .env.cloud.example).
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456
GRAFANA_CLOUD_OTLP_TOKEN=<token with traces:write scope>

# Model keys. Each model on the start screen needs its own.
OPENAI_API_KEY=<key for gpt-6-luna>
ANTHROPIC_API_KEY=<key for claude-haiku-5-5>

# Which models are offered (the allow-list) and which is preselected. Known ids: haiku-5.5, luna-6.
GAMBIT_MODELS=haiku-5.5,luna-6
GAMBIT_DEFAULT_MODEL=haiku-5.5

# Limits (the defaults shown are what the compose file uses when these are unset).
GAMBIT_MAX_GAMES_PER_HOUR=12
GAMBIT_MAX_GAMES_PER_DAY=150
GAMBIT_IDLE_TIMEOUT=3m
GAMBIT_GAME_TOKEN_BUDGET=300000

# Run without calling a model (no keys needed): GAMBIT_EXTRA_ARGS=--mock
GAMBIT_EXTRA_ARGS=

# Local testing only: Caddy's host ports (default 80/443) and where it reads passcodes.
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
# GAMBIT_AUTH_DIR=./.local-auth   # a directory holding users.caddy: see deploy/gcp/README.md
