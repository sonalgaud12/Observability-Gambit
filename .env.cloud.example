# Copy to .env.cloud and fill in. .env.cloud is git-ignored; never commit real values.
# Used only by `make up-cloud`.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456
GRAFANA_CLOUD_OTLP_TOKEN=<token with traces:write scope>

# Optional labels for this run, so dashboards can tell runs apart.
GAMBIT_RUN=my-run
GAMBIT_MODEL=gpt-4o-mini
